# PinePoint environment variables (plan section 4.4).
# Copy to .env.local and fill in. Never commit values. The repo is public.

# Pine project key
PINE_SANDBOX_API_KEY=
# Pine API endpoint
PINE_SANDBOX_ENDPOINT=

ANTHROPIC_API_KEY=
# Planner and STE rewrite model
PLANNER_MODEL=
# Fix agent model
FIX_MODEL=

# Fine-grained token for vihuynh72/pinepoint only
GITHUB_TOKEN=

# Neon connection string
DATABASE_URL=
# Vercel Blob
BLOB_READ_WRITE_TOKEN=
# 32 random bytes, base64
ENCRYPTION_KEY=

# Public URL of pinepoint-web
APP_BASE_URL=
# Production URL of pinepoint-demo-store
DEMO_PRODUCTION_URL=
# Vercel project name of the demo store
VERCEL_DEMO_PROJECT_NAME=

# GitHub webhook (POST /api/github/webhook). The secret you type in the repo's webhook settings.
# It also signs the server's own calls to POST /api/runs/[id]/drive. Long and random, for example: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=
# Comma separated path prefixes. The webhook starts a run only for a PR that changes a file under one of them.
# Unset means apps/demo-store/
PINEPOINT_WEBHOOK_PATHS=
