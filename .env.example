# PinePoint environment variables (plan section 4.4).
# Copy to .env.local and fill in. Never commit values. The repo is public.

# Pine project key
PINE_SANDBOX_API_KEY=
# Pine API endpoint
PINE_SANDBOX_ENDPOINT=

ANTHROPIC_API_KEY=
# Planner and STE rewrite model
PLANNER_MODEL=
# Fix agent model
FIX_MODEL=

# Fine-grained token for vihuynh72/pinepoint only
GITHUB_TOKEN=

# Neon connection string
DATABASE_URL=
# Vercel Blob
BLOB_READ_WRITE_TOKEN=
# 32 random bytes, base64
ENCRYPTION_KEY=

# Public URL of pinepoint-web
APP_BASE_URL=
# Production URL of pinepoint-demo-store
DEMO_PRODUCTION_URL=
# Vercel project name of the demo store
VERCEL_DEMO_PROJECT_NAME=

# GitHub webhook (POST /api/github/webhook). The secret you type in the repo's webhook settings.
# It also signs the server's own calls to POST /api/runs/[id]/drive. Long and random, for example: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=
# Comma separated path prefixes. The webhook starts a run only for a PR that changes a file under one of them.
# Unset means apps/demo-store/
PINEPOINT_WEBHOOK_PATHS=

# GitHub App: sign-in and organization access (docs/github-access-contract.md). Without these, sign-in is off and
# the app works as the public demo alone. Register one app with: Redirect URI (GitHub's name for the OAuth callback URL)
# {APP_BASE_URL}/api/auth/github/callback,
# "Request user authorization (OAuth) during installation" on, "Expire user authorization tokens" on,
# Setup URL {APP_BASE_URL}/api/github/install/callback with "Redirect on update" on, Webhook URL
# {APP_BASE_URL}/api/github/webhook with GITHUB_WEBHOOK_SECRET. Permissions: Metadata read, Contents read,
# Pull requests write, Deployments read, Commit statuses read, Organization members read.
# Events: installation, installation_repositories, github_app_authorization (the demo also needs pull_request, deployment_status).
GITHUB_APP_ID=
# The app's URL slug (github.com/apps/<slug>)
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# The PEM private key. One line with \n for newlines, or the literal multi-line value.
GITHUB_APP_PRIVATE_KEY=
# Comma separated owner/name pairs that the public demo form and the webhook may start without a session.
# Unset means vihuynh72/pinepoint. GITHUB_TOKEN is used for these only.
PINEPOINT_DEMO_REPOS=
