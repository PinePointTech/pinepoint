{
  "name": "@pinepoint/runner",
  "version": "0.0.0",
  "private": true,
  "description": "Pine Computer wrapper. Server code only.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --env-file-if-exists=../../.env.local --import tsx --test \"src/**/*.test.ts\"",
    "spike": "tsx scripts/spike.ts",
    "test:run": "node --env-file-if-exists=../../.env.local --import tsx scripts/test-run.ts"
  },
  "dependencies": {
    "@pinepoint/core": "workspace:*",
    "@pinesandbox/computer": "0.3.3",
    "@vercel/blob": "2.8.2"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  }
}
