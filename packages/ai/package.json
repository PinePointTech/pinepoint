{
  "name": "@pinepoint/ai",
  "version": "0.0.0",
  "private": true,
  "description": "Anthropic calls for the planner, the STE rewrite, the STE lint and the fix.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --env-file-if-exists=../../.env.local --import tsx --test \"src/**/*.test.ts\"",
    "test:planner": "node --env-file-if-exists=../../.env.local --import tsx scripts/test-planner.ts",
    "test:findings": "node --env-file-if-exists=../../.env.local --import tsx scripts/test-findings.ts",
    "test:fix": "node --env-file-if-exists=../../.env.local --import tsx scripts/test-fix.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@pinepoint/core": "workspace:*",
    "@pinepoint/github": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  }
}
